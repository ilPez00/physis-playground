<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
    xml:base="http://example.org/ontology/physis-world-model/"
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:ont="http://example.org/ontology/physis-world-model/">

    <owl:Ontology rdf:about="http://example.org/ontology/physis-world-model/">
        <rdfs:label>Physis World Model</rdfs:label>
        <rdfs:comment>A canonical Physis world: observations from named sources, identity established across domains, and inferences whose premises are visible. Retract a premise and watch which conclusions survive.</rdfs:comment>
    </owl:Ontology>

    <!-- ===================== -->
    <!-- Entity Types (Classes) -->
    <!-- ===================== -->

    <owl:Class rdf:about="http://example.org/ontology/physis-world-model/Printer">
        <rdfs:label>Printer</rdfs:label>
        <rdfs:comment>A physical printer observed by the fleet monitor. Grounded by device telemetry: every instance exists because a source reported it.</rdfs:comment>
        <ont:icon>🖨️</ont:icon>
        <ont:color>#0078D4</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/physis-world-model/Job">
        <rdfs:label>Print-Job</rdfs:label>
        <rdfs:comment>A print job observed in the printer queue. Grounded by queue events with timestamps; a job the queue never reported does not exist here.</rdfs:comment>
        <ont:icon>📄</ont:icon>
        <ont:color>#7719AA</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/physis-world-model/InventoryItem">
        <rdfs:label>Inventory-Item</rdfs:label>
        <rdfs:comment>A consumable tracked by the warehouse system. Grounded by stock records; the same physical toner cartridge may appear under two SKUs until identity merges them.</rdfs:comment>
        <ont:icon>📦</ont:icon>
        <ont:color>#107C10</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/physis-world-model/Location">
        <rdfs:label>Location</rdfs:label>
        <rdfs:comment>A place where equipment or stock is observed. Grounded by the observation that places something there — not by a directory entry.</rdfs:comment>
        <ont:icon>📍</ont:icon>
        <ont:color>#FFB900</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/physis-world-model/Observation">
        <rdfs:label>Observation</rdfs:label>
        <rdfs:comment>The act of a source reporting something at a time. In Physis, facts exist because observations support them — this type makes that visible.</rdfs:comment>
        <ont:icon>👁️</ont:icon>
        <ont:color>#8A8886</ont:color>
    </owl:Class>

    <!-- ================ -->
    <!-- Data Properties -->
    <!-- ================ -->

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/physis-world-model/printer_printerId">
        <rdfs:label>printerId</rdfs:label>
        <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
        <rdfs:domain rdf:resource="http://example.org/ontology/physis-world-model/Printer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.org/ontology/physis-world-model/printer_model">
        <rdfs:label>model</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/physis-world-model/Printer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.org/ontology/physis-world-model/printer_state">
        <rdfs:label>state</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/physis-world-model/Printer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.org/ontology/physis-world-model/printer_observedBy">
        <rdfs:label>observedBy</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/physis-world-model/Printer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.org/ontology/physis-world-model/job_jobId">
        <rdfs:label>jobId</rdfs:label>
        <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
        <rdfs:domain rdf:resource="http://example.org/ontology/physis-world-model/Job"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.org/ontology/physis-world-model/job_pages">
        <rdfs:label>pages</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/physis-world-model/Job"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.org/ontology/physis-world-model/job_state">
        <rdfs:label>state</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/physis-world-model/Job"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.org/ontology/physis-world-model/job_queuedAt">
        <rdfs:label>queuedAt</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/physis-world-model/Job"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.org/ontology/physis-world-model/item_sku">
        <rdfs:label>sku</rdfs:label>
        <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
        <rdfs:domain rdf:resource="http://example.org/ontology/physis-world-model/InventoryItem"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.org/ontology/physis-world-model/item_kind">
        <rdfs:label>kind</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/physis-world-model/InventoryItem"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.org/ontology/physis-world-model/item_stockQty">
        <rdfs:label>stockQty</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/physis-world-model/InventoryItem"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.org/ontology/physis-world-model/item_warehouse">
        <rdfs:label>warehouse</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/physis-world-model/InventoryItem"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.org/ontology/physis-world-model/location_locationId">
        <rdfs:label>locationId</rdfs:label>
        <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
        <rdfs:domain rdf:resource="http://example.org/ontology/physis-world-model/Location"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.org/ontology/physis-world-model/location_name">
        <rdfs:label>name</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/physis-world-model/Location"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.org/ontology/physis-world-model/location_building">
        <rdfs:label>building</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/physis-world-model/Location"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.org/ontology/physis-world-model/observation_observationId">
        <rdfs:label>observationId</rdfs:label>
        <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
        <rdfs:domain rdf:resource="http://example.org/ontology/physis-world-model/Observation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.org/ontology/physis-world-model/observation_source">
        <rdfs:label>source</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/physis-world-model/Observation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.org/ontology/physis-world-model/observation_observedAt">
        <rdfs:label>observedAt</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/physis-world-model/Observation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.org/ontology/physis-world-model/observation_claim">
        <rdfs:label>claim</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/physis-world-model/Observation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <!-- ==================== -->
    <!-- Object Properties -->
    <!-- ==================== -->

    <owl:ObjectProperty rdf:about="http://example.org/ontology/physis-world-model/job_prints_on">
        <rdfs:label>prints-on</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/physis-world-model/Job"/>
        <rdfs:range rdf:resource="http://example.org/ontology/physis-world-model/Printer"/>
        <rdfs:comment>OBSERVED: the queue reported this job on this printer. The source and time are part of the fact.</rdfs:comment>
        <ont:cardinality>many-to-many</ont:cardinality>
        <ont:fromEntityId>job</ont:fromEntityId>
        <ont:toEntityId>printer</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/physis-world-model/printer_consumes">
        <rdfs:label>consumes</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/physis-world-model/Printer"/>
        <rdfs:range rdf:resource="http://example.org/ontology/physis-world-model/InventoryItem"/>
        <rdfs:comment>OBSERVED with an identity caveat: the printer reports toner use by device-local name; the warehouse uses SKUs. Physis establishes identity between the two namings before this edge is admitted.</rdfs:comment>
        <ont:cardinality>many-to-many</ont:cardinality>
        <ont:fromEntityId>printer</ont:fromEntityId>
        <ont:toEntityId>inventoryItem</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/physis-world-model/printer_located_in">
        <rdfs:label>located-in</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/physis-world-model/Printer"/>
        <rdfs:range rdf:resource="http://example.org/ontology/physis-world-model/Location"/>
        <rdfs:comment>OBSERVED: a scan or placement record puts this printer in this location.</rdfs:comment>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:fromEntityId>printer</ont:fromEntityId>
        <ont:toEntityId>location</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/physis-world-model/item_stocked_at">
        <rdfs:label>stocked-at</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/physis-world-model/InventoryItem"/>
        <rdfs:range rdf:resource="http://example.org/ontology/physis-world-model/Location"/>
        <rdfs:comment>OBSERVED: the warehouse record places stock at this location.</rdfs:comment>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:fromEntityId>inventoryItem</ont:fromEntityId>
        <ont:toEntityId>location</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/physis-world-model/location_can_serve">
        <rdfs:label>can-serve</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/physis-world-model/Location"/>
        <rdfs:range rdf:resource="http://example.org/ontology/physis-world-model/Location"/>
        <rdfs:comment>INFERRED: derived by the delivery-zone rule from stocked-at and located-in edges. The premises are named; retracting one retracts this conclusion through truth maintenance.</rdfs:comment>
        <ont:cardinality>many-to-many</ont:cardinality>
        <ont:fromEntityId>location</ont:fromEntityId>
        <ont:toEntityId>location</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/physis-world-model/job_supported_by">
        <rdfs:label>supported-by</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/physis-world-model/Job"/>
        <rdfs:range rdf:resource="http://example.org/ontology/physis-world-model/Observation"/>
        <rdfs:comment>PROVENANCE: links a claim to the observation that grounds it. Asking why Physis believes this walks these edges.</rdfs:comment>
        <ont:cardinality>many-to-many</ont:cardinality>
        <ont:fromEntityId>job</ont:fromEntityId>
        <ont:toEntityId>observation</ont:toEntityId>
    </owl:ObjectProperty>
</rdf:RDF>
